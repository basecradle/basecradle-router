# BaseCradle fleet router — TLS front end for the webhook endpoint.
#
# Install to /etc/caddy/Caddyfile (replacing the package default), then
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Caddy automatically obtains and renews a Let's Encrypt certificate for the
# hostname below (needs inbound 80 for the ACME challenge + 443 for traffic).
# It reverse-proxies to the local uvicorn the systemd unit runs on 127.0.0.1:8000.
{
	servers {
		# A request on 443 whose Host is not the name its TLS handshake asked for is answered
		# 421 Misdirected Request by Caddy itself, before any site is consulted (#428). Without
		# it, a foreign Host under this box's SNI matched no site and Caddy answered an empty
		# 200, so the box confirmed every name anyone tried. HTTP/2 and HTTP/3 carry the Host
		# as :authority, which is checked the same way. It binds TLS only; port 80 is the
		# catch-all `http://` site at the end of this file.
		strict_sni_host on
	}
}

red.basecradle.com {
	# The security response headers, the full set (F-002: #428, #432). Each is set directly in
	# the site, so it rides every answer the site gives (a proxied answer, the masked probe
	# path, a 502 while the daemon is down) and nothing nested can drop it. Answers Caddy gives
	# before any site runs carry none of them: the 421 for a foreign Host under this box's SNI,
	# and everything on port 80 (the catch-all's 421, the redirect to HTTPS).
	#
	# HSTS: a browser that has once reached this name over TLS never tries it in plain HTTP
	# again. Two years, the age the major browsers' guidance gives. No includeSubDomains,
	# reconsidered in #432 and still left off: this box serves one name and does not own the
	# names below it, so it makes no promise for them. No preload, which is a commitment for a
	# registrable domain, not a host.
	#
	# X-Content-Type-Options guards today's answers: a browser keeps their declared
	# Content-Type (a JSON verdict, the fixed /up body) and never sniffs one into HTML or
	# script.
	#
	# The other four guard a page this name does not serve yet: no answer echoes a caller's
	# input. They are sent for completeness, as defense in depth: they cost nothing on these
	# answers, they are already right the day a real page is served here, and a box on a
	# security-research platform is expected to carry the whole set, which every scan checks.
	# - X-Frame-Options, for older browsers, and the CSP's frame-ancestors, for current ones:
	#   no answer can be framed.
	# - Referrer-Policy: a link followed from an answer sends no Referer.
	# - Permissions-Policy: the powerful features a page could ask for (sensors, camera,
	#   microphone, screen capture, location, payment, USB) are denied to every origin.
	# - Content-Security-Policy: nothing may load from anywhere. default-src does not cover
	#   base-uri, form-action or frame-ancestors, so each is denied by name.
	#
	# /up gets the one exception (#440). Its fixed body paints the page green with a single
	# inline style attribute, `background-color: green`, and default-src 'none' governs style
	# attributes too, so under the bare policy a browser refused it and showed the page white.
	# On /up alone the policy also allows exactly that attribute, by its hash: style-src-attr
	# with 'unsafe-hashes' and the sha256 of those 23 bytes. Nothing else is allowed, there is
	# no 'unsafe-inline', and the body echoes no input, so no other style can match the hash.
	# The map picks the policy by exact path, so every other path, `/up/` included, keeps the
	# bare policy byte for byte, and the header is still set by one line, directly in the site.
	#
	# The Server and Via banners stay: they name only what this public repository already
	# publishes, and they are the one cue that tells an operator whether Caddy or the daemon
	# answered.
	header Strict-Transport-Security "max-age=63072000"
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "DENY"
	header Referrer-Policy "no-referrer"
	header Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
	map {path} {csp} {
		/up "default-src 'none'; style-src-attr 'unsafe-hashes' 'sha256-SYA5Rvt/4mtTFmPcI2Waa1tuW+qqev+OP/UMRlh1n/E='; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		default "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
	header Content-Security-Policy "{csp}"

	# Cap the request body at the edge: the outer fence. GitHub caps its own deliveries at
	# 25 MB, so this is the largest any source sends. The daemon holds each route to its own,
	# tighter cap from the path alone, before it reads a byte (#427); this bounds what reaches
	# it at all.
	request_body {
		max_size 25MB
	}

	# The synthetic-wake injection point is ON-BOX ONLY (basecradle-router#208). The probe
	# CLI posts to 127.0.0.1:8000 directly, so it never passes through here, and nothing
	# legitimate ever arrives from the internet for this path. So the path is rewritten to
	# one that names no route, and the daemon answers it as it answers an unknown source
	# (#428): `/webhooks/probe` exactly as `/webhooks/<unknown>`, and anything below it
	# exactly as `/webhooks/<unknown>/<anything>`, status, body and headers alike, because the
	# same code writes both. So the answer never depends on whether the route is enabled on
	# the daemon behind this edge, which is the one thing the mask hides. (Answering it here
	# instead gave Caddy's empty 404 against the daemon's JSON one.) The rewrite runs before
	# the proxy, so the route is never reached from here: the path matcher merges slashes and
	# reads the decoded path, so `//probe` and `%70robe` are caught too. It also ignores case
	# and resolves `.` and `..` segments, which the daemon does not, so `/WEBHOOKS/PROBE` and
	# `/webhooks/./probe` are answered as an unknown source where `/WEBHOOKS/FOO` and
	# `/webhooks/./foo` get the daemon's not-found and no-route answers. That shows the mask
	# is here, which this public file says anyway, and nothing about the route behind it.
	# `tests/test_caddyfile.py` pins that the target names no route the daemon can register.
	@probe path /webhooks/probe /webhooks/probe/
	rewrite @probe /webhooks/probe-masked
	@probe_below path /webhooks/probe/*
	rewrite @probe_below /webhooks/probe-masked/below

	reverse_proxy 127.0.0.1:8000 {
		# Hold a request across a daemon restart instead of answering it 502 (#264). Every
		# merge to main restarts the daemon (the NOC's unattended deploy tick), and while
		# uvicorn's listener is down the dial is refused. With no retry, Caddy answered 502
		# at once, and GitHub does not redeliver a failed webhook, so a delivery that
		# landed in that gap was a lost wake. Now Caddy re-dials every 250 ms (the
		# lb_try_interval default) for up to 5 s.
		#
		# - Safe for a POST: Caddy retries only a failed DIAL for a non-GET request (the
		#   lb_retry_match default), and a failed dial means the request never reached the
		#   daemon. A delivery that reached it and then failed is not retried, so this can
		#   never deliver one twice.
		# - Why 5 s: that is many times the gap (a restart of an idle daemon took 0.18 s,
		#   basecradle-noc#695) and half GitHub's 10 s delivery timeout, so a held
		#   delivery is still answered in time. A daemon that is really down gets its 502
		#   5 s later than before, which GitHub records exactly as it records an
		#   immediate 502.
		# - Needs Caddy >= 2.11.4. Older releases closed an unread request body on a dial
		#   error, so the retried POST failed with a 502 anyway (caddy#7546, fixed by
		#   caddy#7715 and caddy#7719). That is never worse than no retry.
		lb_try_duration 5s
	}

	# Access log to the journal; Caddy logs TLS/ACME there too.
	log {
		output stderr
		format console
	}
}

# Port 80 redirects only this box's own name to HTTPS (#428). Caddy's automatic redirect
# still serves that name, because the site above is the one it manages, and the ACME HTTP
# challenge is answered before any site is consulted. Every other Host — a made-up name,
# a bare IP — reaches this catch-all and is refused 421, instead of the 308 to
# `https://<Host as sent>` the automatic catch-all used to send: a redirect anyone could aim
# at any name, and for a bare IP one that could never complete a TLS handshake.
http:// {
	respond 421
}

# Optional: set an ACME account email for Let's Encrypt expiry notices by adding
#   email ops@basecradle.com
# to the global options block at the top of this file.
