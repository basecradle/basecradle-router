#!/usr/bin/env bash
# BaseCradle router — admin CLI wrapper: run a claims/probe command AS THE DAEMON.
#
# The NOC's converge and its Layer-3 synthetic-exercise scheduler call this one
# stable path (it is what the emitted claim's `prove.cmd` names), so they never have
# to reconstruct the privilege drop, the env file, or the venv:
#
#   /opt/basecradle-router/app/deploy/bin/router-admin selftest freeze --json
#   /opt/basecradle-router/app/deploy/bin/router-admin claims
#   /opt/basecradle-router/app/deploy/bin/router-admin evidence
#   <mint> | .../router-admin probe wake --agent <slug> --json     # the synthetic wake (#208)
#
# `probe wake` needs the drop for a second reason on top of the one below: it reads the
# `probe` route's signing secret out of router.env (0600, daemon-owned) to sign the
# delivery it fires at the daemon's own loopback listener. Its BCNOC1 marker arrives on
# STDIN — minted by the NOC with the recipient agent's own probe secret, which the router
# never holds — and stdin survives the `runuser` re-exec below because `exec` keeps fds.
#
# WHY THE PRIVILEGE DROP IS THE POINT, not a nicety. `selftest freeze` proves the
# NOC wake-lock directory is readable *with the credentials the daemon actually
# has*. Root bypasses file permissions, so a probe run as root would pass on a box
# where the daemon itself is locked out — which is exactly the 2026-06-28
# `root:router 640` failure it exists to catch. So: if we are not already the daemon
# user, re-exec ourselves as it via `runuser` (root only) and let the child do the
# rest. The probe reports its own effective user, so a drop that silently failed is
# still visible in the output.
#
# READ-ONLY. Nothing here writes the router's state: the daemon is the sole writer
# of /var/lib/basecradle-router/evidence.json, so a probe run under the wrong
# identity can never take ownership of the daemon's own state file away from it.
#
# EXIT CODES (the probe contract the NOC schedules against — basecradle-noc#408):
#   0   proven          — the surface is readable and would be honoured. PASS, and the
#                         only thing the ledger records as evidence.
#   1   proven broken   — unreadable or malformed; the check names the exact file. FAIL:
#                         we asked, and the answer is no.
#   75  could not prove — EX_TEMPFAIL, the contract's one inconclusive sentinel: we
#                         never got an answer. Dir absent, a stale lock, the probe ran
#                         as root, or the router's own config would not load (a finding
#                         in its own right — the daemon could not boot on it either).
#                         Still red, still immediate; there is deliberately no quieter
#                         tier. WHICH of those it was rides on STDERR, which the NOC
#                         forwards on any non-proven verdict.
# Any other non-zero reads as FAIL. Nothing here may exit 0 without having proven it.

set -euo pipefail

# Kept in lockstep with selftest.EXIT_UNPROVABLE — the wrapper's own failures are the
# same state as the probe's ("we never got an answer"), so they must not land in a
# different bucket than the tool they wrap.
EXIT_UNPROVABLE=75

APP_DIR=${BASECRADLE_ROUTER_APP_DIR:-/opt/basecradle-router/app}
ENV_FILE=${BASECRADLE_ROUTER_ENV_FILE:-/etc/basecradle-router/router.env}
RUN_AS=${BASECRADLE_ROUTER_USER:-router}
# Read-only from here on: router.env is exported into this same shell below, and a key
# that happened to share one of these names must be a loud refusal, never a silent
# redirect of the wrapper's own exec or exit contract.
readonly EXIT_UNPROVABLE APP_DIR ENV_FILE RUN_AS

# Re-exec as the daemon's user when we are not already it. Only root can, and only
# root needs to: the daemon user running this reaches the `else` branch directly.
if [ "$(id -un)" != "$RUN_AS" ]; then
    if [ "$(id -u)" -ne 0 ]; then
        echo "router-admin: must run as '$RUN_AS' or as root (am $(id -un))" >&2
        exit "$EXIT_UNPROVABLE"
    fi
    exec runuser -u "$RUN_AS" -- "$0" "$@"
fi

# The daemon's own configuration, read the same way systemd reads it for the unit:
# the emitter and the probe must see exactly the registry, routes, lock dir, and
# evidence path the running daemon sees, or they would describe a router that does
# not exist. router.env is 0600 and owned by the daemon user, which is why this is
# read *after* the drop and never before it.
#
# PARSED LITERALLY, NEVER `source`d (#109) — the same rule wake-runner applies to an
# agent's env file, and for the same reason: router.env holds the webhook signing
# secret, and a credential is DATA, not code. `set -a; . "$ENV_FILE"` would evaluate
# every value, so a secret containing `$` would be mangled (and abort under `set -u`)
# and one containing `$( )` would EXECUTE as the daemon user. systemd's
# EnvironmentFile= parses literally, and systemd_env_file below is a transcription of
# that parser (#419) — the same block deploy/smoke-test.sh carries, pinned identical by
# tests/test_router_env_parse.py — so the CLI's view of the config is byte-identical to the
# running daemon's: the last line of a duplicated key wins, and a line systemd drops (an
# `export ` prefix among them) is dropped here too.
if [ ! -r "$ENV_FILE" ]; then
    echo "router-admin: cannot read $ENV_FILE as $(id -un)" >&2
    exit "$EXIT_UNPROVABLE"
fi
# >>> systemd_env_file >>>
# Reads env file $1 exactly the way the daemon's unit receives it through systemd 255's
# EnvironmentFile= (src/basic/env-file.c parse_env_file_internal, then load_env_file_push
# and strv_env_clean): a direct transcription of that state machine, never `source`.
# Sets the parallel arrays ENV_FILE_NAMES / ENV_FILE_VALUES to the assignments the unit
# gets, each name once, at its first position, carrying its LAST value, and sets
# ENV_FILE_PARSED. Returns non-zero when $1 cannot be opened as a regular file, which
# systemd would refuse too: never an empty environment that reads as every key absent.
#
# What that means for a file, so the cases below need no C to read:
#   - `#` and `;` start a comment; leading and trailing whitespace, around the key and
#     around an unquoted value, is dropped; interior whitespace is kept.
#   - '...' is literal; "..." honours \" \\ \` \$ and keeps any other backslash; both
#     may span lines. Quotes concatenate (`"a" 'b'c` is `abc`), but a quote AFTER the
#     first unquoted character is a literal byte. Unquoted, `\x` is `x`, and a
#     trailing `\` joins the next line.
#   - No expansion: `$X` and `$(...)` are bytes, never evaluated.
#   - A name that is not a valid shell variable name is dropped, so an `export `
#     prefix (name `export KEY`) drops the line: systemd does not strip it.
#
# One gap, deliberately left: systemd refuses a file whose keys or values are not
# valid UTF-8, and then the unit does not start at all. Bash cannot check that
# cheaply, and a daemon that never starts fails every gate on its own.
#
# Byte semantics (LC_ALL=C) so `${content:i:1}` is one byte, as the C reads it. The
# whole file is read, NUL excepted, so a quoted value's trailing newlines survive.
# Pure bash, no pipeline: see tests/test_shell_pipeline_safety.py.
systemd_env_file() {
    local LC_ALL=C
    local content='' c state=pre_key key='' value='' key_ws=-1 value_ws=-1 i j n
    local -a names=() values=()
    [[ -f "$1" ]] || return 1
    # `read` exits 1 at the end of a file with no NUL, so only the redirect's failure counts.
    { IFS= read -r -d '' content || true; } <"$1" || return 1
    n=${#content} # once: bash recounts a string's length on every ${#...}
    ENV_FILE_NAMES=()
    ENV_FILE_VALUES=()
    for ((i = 0; i <= n; i++)); do
        if ((i == n)); then
            c=eof
        else
            c=${content:i:1}
        fi
        case "$state" in
        pre_key)
            case "$c" in
            eof) ;;
            '#' | ';') state=comment ;;
            ' ' | $'\t' | $'\n' | $'\r') ;;
            *)
                state=key key_ws=-1 key=$c
                ;;
            esac
            ;;
        key)
            case "$c" in
            eof) ;;
            $'\n' | $'\r') state=pre_key key='' ;;
            '=') state=pre_value value_ws=-1 value='' ;;
            ' ' | $'\t')
                ((key_ws >= 0)) || key_ws=${#key}
                key+=$c
                ;;
            *)
                key_ws=-1
                key+=$c
                ;;
            esac
            ;;
        pre_value | value | value_escape | single_quote | double_quote | double_quote_escape)
            # The states a push can end, at a newline or at the end of the file.
            if [[ "$c" == eof ]] ||
                { [[ "$state" == pre_value || "$state" == value ]] &&
                    [[ "$c" == $'\n' || "$c" == $'\r' ]]; }; then
                if [[ "$state" == value ]] && ((value_ws >= 0)); then
                    value=${value:0:value_ws}
                fi
                ((key_ws < 0)) || key=${key:0:key_ws}
                for ((j = 0; j < ${#names[@]}; j++)); do
                    [[ "${names[j]}" != "$key" ]] || break
                done
                names[j]=$key
                values[j]=$value
                state=pre_key key='' value=''
                continue
            fi
            case "$state" in
            pre_value)
                case "$c" in
                "'") state=single_quote ;;
                '"') state=double_quote ;;
                \\) state=value_escape ;;
                ' ' | $'\t') ;;
                *)
                    state=value
                    value+=$c
                    ;;
                esac
                ;;
            value)
                case "$c" in
                \\)
                    state=value_escape value_ws=-1
                    ;;
                ' ' | $'\t')
                    ((value_ws >= 0)) || value_ws=${#value}
                    value+=$c
                    ;;
                *)
                    value_ws=-1
                    value+=$c
                    ;;
                esac
                ;;
            value_escape)
                state=value
                [[ "$c" == $'\n' || "$c" == $'\r' ]] || value+=$c
                ;;
            single_quote)
                if [[ "$c" == "'" ]]; then state=pre_value; else value+=$c; fi
                ;;
            double_quote)
                case "$c" in
                '"') state=pre_value ;;
                \\) state=double_quote_escape ;;
                *) value+=$c ;;
                esac
                ;;
            double_quote_escape)
                state=double_quote
                case "$c" in
                '"' | \\ | '`' | '$') value+=$c ;;
                $'\n') ;;
                *) value+="\\$c" ;;
                esac
                ;;
            esac
            ;;
        comment)
            case "$c" in
            \\) state=comment_escape ;;
            $'\n' | $'\r') state=pre_key ;;
            esac
            ;;
        comment_escape)
            case "$c" in
            $'\n' | $'\r') state=pre_key ;;
            *) state=comment ;;
            esac
            ;;
        esac
    done
    # strv_env_clean: a name systemd would not set is dropped, never passed on.
    for ((j = 0; j < ${#names[@]}; j++)); do
        case "${names[j]}" in
        '' | [0-9]* | *[!A-Za-z0-9_]*) ;;
        *)
            ENV_FILE_NAMES+=("${names[j]}")
            ENV_FILE_VALUES+=("${values[j]}")
            ;;
        esac
    done
    # shellcheck disable=SC2034 # env_value reads it; this block is shared verbatim
    ENV_FILE_PARSED=1
    return 0
}
# <<< systemd_env_file <<<
if ! systemd_env_file "$ENV_FILE"; then
    echo "router-admin: cannot read $ENV_FILE as a regular file" >&2
    exit "$EXIT_UNPROVABLE"
fi
# `export NAME=VALUE` assigns the literal bytes — never re-parsed for expansion or
# command substitution. The exports run on positional parameters alone, because every
# name the file sets lands in this shell: a named loop counter or list would be one key
# away from being overwritten mid-loop, and the CLI would get a different environment
# than systemd gives the daemon. A name bash refuses to set (UID, PPID, SHELLOPTS, the
# readonly settings above) means the wrapper cannot hand the CLI the daemon's config:
# could not prove, never proven broken.
export_env_pairs() {
    while (($# >= 2)); do
        # Probed in a subshell first: a non-interactive bash exits outright on an
        # `export` of a readonly name, so the refusal could not be caught in place.
        if ! (export "$1=$2") 2>/dev/null; then
            echo "router-admin: cannot pass $1 from $ENV_FILE to the CLI: bash reserves the name" >&2
            exit "$EXIT_UNPROVABLE"
        fi
        export "$1=$2"
        shift 2
    done
}
env_pairs=()
for ((i = 0; i < ${#ENV_FILE_NAMES[@]}; i++)); do
    env_pairs+=("${ENV_FILE_NAMES[i]}" "${ENV_FILE_VALUES[i]}")
done
export_env_pairs ${env_pairs[@]+"${env_pairs[@]}"}

# Prefer the venv's python directly: it is faster than `uv run` and, more to the
# point, side-effect-free — a probe the NOC runs on a schedule must never re-sync
# the daemon's dependencies underneath it. Fall back to `uv run` if the venv is not
# where the deploy leaves it.
if [ -x "$APP_DIR/.venv/bin/python" ]; then
    exec "$APP_DIR/.venv/bin/python" -m basecradle_router "$@"
fi
exec "${UV_BIN:-$HOME/.local/bin/uv}" run --project "$APP_DIR" python -m basecradle_router "$@"
