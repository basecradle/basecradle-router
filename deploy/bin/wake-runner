#!/usr/bin/env bash
#
# wake-runner — the wake privilege boundary on the fleet home server.
#
# Installed ROOT-OWNED at /opt/basecradle-router/bin/wake-runner (root:root, 0755,
# in a root-owned directory the `router` user cannot write). The unprivileged
# `router` daemon invokes it through one locked sudoers rule:
#
#   sudo /opt/basecradle-router/bin/wake-runner --user <os_user> --cwd <clone> -- claude -p "<trigger>"
#
# It validates the request, drops to the agent's own OS user, and runs the wake
# in the agent's clone with the agent's own credentials. The router never runs as
# root and never reads an agent's secrets — the wrapper drops privileges first,
# then (as the agent) loads that agent's env. The env file is parsed as literal
# KEY=VALUE lines, never bash-sourced, so a secret containing a shell-special
# character ($, backtick, $( ), spaces, quotes) is data and never code (#109).
# This is the runtime contract the HomeServerWaker (#29) assembles against.
#
# Two agent kinds are wakeable, selected by the registry entry's `kind`:
#   - a builder ("github", the default): only the trusted, system-installed
#     `claude` may be launched, resolved off a root-owned PATH;
#   - a harness persona ("harness", e.g. @jt): only the exact `wake_bin` the
#     registry pins for that agent may be launched (its own wake CLI in its venv).
# Either way the binary is decided by the ROOT-OWNED registry, never by the
# caller's argv, so a compromised router cannot substitute a different command.
#
# The boundary, stated as invariants this script enforces:
#   - only root (via the sudoers rule) may run it;
#   - the target must be a real agent login user (UID >= 1000, never root/system),
#     registered in the agent registry with exactly the requested clone path;
#   - only the registry-sanctioned binary for that agent may be launched —
#     `claude` for a builder, the pinned `wake_bin` for a harness persona — and a
#     harness `wake_bin` must resolve inside the agent's own home;
#   - the agent's secrets are read by the AGENT, after the privilege drop, and
#     parsed literally (KEY=VALUE), never evaluated as shell.
# Even a fully-compromised router can therefore only do what it can already do
# legitimately — wake a registered agent with that agent's own sanctioned command.
#
# The wake's stdout+stderr are routed into journald under the per-agent identifier
# `basecradle-wake-<os_user>` (via systemd-cat, wrapping runuser) so the harness's
# per-step ledger is attributable and survives a crash — see the systemd-cat block
# below. It preserves every security invariant above (it only redirects fds and
# exec's straight through to runuser); its one added dependency is that the journal
# stream be openable at wake time — see that block for the deliberate consequences.
#
set -euo pipefail

REGISTRY=/etc/basecradle-router/agents.json
MIN_UID=1000
# The one trusted PATH off which root-owned system binaries (claude, systemd-cat)
# are resolved — never the caller's PATH, so a compromised router cannot plant one.
TRUSTED_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

die() {
	printf 'wake-runner: %s\n' "$*" >&2
	exit 1
}

[[ ${EUID:-$(id -u)} -eq 0 ]] || die "must run as root (via the sudoers rule)"

user=""
cwd=""
while [[ $# -gt 0 ]]; do
	case "$1" in
	--user)
		[[ $# -ge 2 ]] || die "--user needs a value"
		user="$2"
		shift 2
		;;
	--cwd)
		[[ $# -ge 2 ]] || die "--cwd needs a value"
		cwd="$2"
		shift 2
		;;
	--)
		shift
		break
		;;
	*) die "unexpected argument before '--': $1" ;;
	esac
done

[[ -n $user ]] || die "missing --user"
[[ -n $cwd ]] || die "missing --cwd"
[[ $# -gt 0 ]] || die "missing command after '--' (expected: claude -p <trigger>)"

# The target must be a real agent login user — never root or a system account.
id -u "$user" >/dev/null 2>&1 || die "no such user: $user"
target_uid="$(id -u "$user")"
[[ $target_uid -ge $MIN_UID ]] || die "refusing: $user (uid $target_uid) is not an agent login user"

# The (user, clone) pair must be registered — the wrapper trusts only the registry.
# Pull, in one shot, the matched entry's key, kind (default "github"), and wake_bin
# so the launched binary is decided by the registry, never the caller's argv.
command -v jq >/dev/null 2>&1 || die "jq is required to validate against the registry"
[[ -r $REGISTRY ]] || die "registry not readable: $REGISTRY"
entry="$(jq -r --arg u "$user" --arg c "$cwd" \
	'to_entries[] | select(.value.os_user == $u and .value.clone_path == $c)
	 | [.key, (.value.kind // "github"), (.value.wake_bin // "")] | @tsv' \
	"$REGISTRY")" || die "could not read registry $REGISTRY"
[[ -n $entry ]] || die "refusing: ($user, $cwd) is not a registered agent clone"
IFS=$'\t' read -r match kind wake_bin <<<"$entry"

# Defence in depth against a poisoned registry: the clone must resolve (no `..`,
# no symlink escape) to a path inside the agent's own home, never elsewhere.
real_cwd="$(realpath -e -- "$cwd" 2>/dev/null)" || die "clone path does not exist: $cwd"
case "$real_cwd/" in
"/home/$user/"*) : ;;
*) die "refusing: clone $cwd resolves outside /home/$user" ;;
esac

# Resolve the binary to launch from the REGISTRY's kind for this agent — never
# from the caller's argv path verbatim. The launched program is whatever the
# root-owned registry sanctions for this agent; argv[1] must match it.
case "$kind" in
github)
	# Only the trusted, system-installed `claude` may ever be launched. A basename
	# check is NOT enough: `exec "$@"` would run a caller-supplied path verbatim, so
	# a binary literally named `claude` planted in an agent-writable dir would pass.
	# Require the bare word and resolve the real binary ourselves, off a trusted
	# PATH — root-owned `claude`, never anything the (compromised) router can plant.
	[[ "$1" == claude ]] || die "refusing: command must be the bare word 'claude', got '$1'"
	launch_bin="$(PATH="$TRUSTED_PATH" command -v claude)" || die "claude not found on the trusted PATH"
	;;
harness)
	# A harness persona's wake CLI lives in its OWN venv (agent-writable), so it
	# cannot be resolved off a root PATH. The control instead is the registry: the
	# launched path must equal the `wake_bin` the registry pins for this agent, and
	# must resolve to a real executable inside the agent's own home. The router
	# supplies argv[1] but cannot deviate from the pinned value; running it as the
	# agent (below) confers no privilege the agent lacks over its own venv.
	[[ -n $wake_bin ]] || die "refusing: harness agent $match has no wake_bin in the registry"
	[[ "$1" == "$wake_bin" ]] || die "refusing: command must be the registered wake_bin '$wake_bin', got '$1'"
	launch_bin="$(realpath -e -- "$1" 2>/dev/null)" || die "wake_bin does not exist: $1"
	case "$launch_bin/" in
	"/home/$user/"*) : ;;
	*) die "refusing: wake_bin $1 resolves outside /home/$user" ;;
	esac
	[[ -x $launch_bin ]] || die "wake_bin is not executable: $launch_bin"
	;;
*)
	die "refusing: agent $match has unknown kind '$kind'"
	;;
esac
shift # drop argv[1]; the remainder (e.g. -p <trigger> or --timeline <uuid>) are its args

# Route the wake's stdout+stderr into journald under a PER-AGENT identifier, so the
# harness's per-step ledger (`step N/M …`, `wake used X/N steps`) is attributable
# and survives a crash — before this, the caller (the router) captured the wake's
# output and dropped it, so none of it reached journald (basecradle-router#168).
# systemd-cat runs HERE, as root, wrapping runuser: it dup2's the wake subtree's
# fds 1/2 onto a journald stream and `execvp`s runuser (no fork), so the security
# invariants above are untouched — the privilege drop, the inert argv, the env
# discipline, and exit-code propagation (runuser's exit, i.e. the wake's, flows
# straight back to the caller) are all byte-for-byte unchanged. The tag is the
# agent's OS-user slug (its universal identity; `journalctl -t basecradle-wake-<slug>`
# reads one persona's wake ledger). systemd-cat is resolved off the trusted PATH —
# the same discipline as `claude` above — never the caller's.
#
# Three deliberate consequences, not bugs:
#   1. The wake now depends on the journal stream being openable: systemd-cat exits
#      non-zero *before* exec'ing runuser if it cannot attach, so a wake then FAILS
#      rather than runs unlogged. Negligible on a healthy box — /run/systemd/journal/
#      stdout is a socket unit that survives a journald restart — and a failure is a
#      retryable non-zero exit that loses no data (the platform read API is the
#      source of truth, push is best-effort).
#   2. The router's own capture_output now sees EOF (the fds point at journald), so a
#      failed wake's detail reads via `journalctl -t basecradle-wake-<slug>`, not the
#      router's WakeError message (which degrades to "(no output)"). By design: the
#      per-agent journal IS the wake's log now.
#   3. Entries are stamped `_UID=0` (the stream is opened as root, pre-drop). Read
#      the ledger by the -t identifier, never by `_UID`.
journal_tag="basecradle-wake-$user"
systemd_cat="$(PATH="$TRUSTED_PATH" command -v systemd-cat)" || die "systemd-cat not found on the trusted PATH"

# Drop to the agent and run the wake: as the agent, load its own env (0600, the
# router never reads it), cd into the clone, exec the registry-sanctioned binary.
# The inline script takes the cwd as $1 and the command (launch_bin + args) as
# $2..; root never interpolates the trigger/timeline — it is passed as an inert
# positional argument.
# SC2016 is intentional: the single quotes are load-bearing — $HOME/$1/$@ must
# expand in the AGENT's bash after runuser, never in root's, so the untrusted
# trigger is never evaluated in a privileged context.
# shellcheck disable=SC2016
exec "$systemd_cat" --identifier="$journal_tag" -- runuser -u "$user" -- /bin/bash -c '
	set -euo pipefail
	# Lock the agent process to umask 077 before anything is written: every file
	# the woken claude creates (memory, settings, scratch) then lands 600 and every
	# dir 700, so each agent memory is private to that agent BY DEFAULT at the
	# filesystem layer -- not only where a migration happened to chmod the bits.
	# This is the single shared launch boundary, so it covers every agent, present
	# and future, and is inherited by the claude exec-ed below. (basecradle-router#57)
	umask 077
	# >>> load_agent_env >>>
	# Load KEY=VALUE pairs from the agent env file LITERALLY -- no shell
	# evaluation, no command substitution. A credential is DATA, not code: a
	# value containing $, a backtick, $( ), spaces, or quotes is taken verbatim.
	# This replaces a bash `source` of the file, which evaluated every value --
	# a secret with a $ (e.g. a random password) aborted the wake under set -u,
	# and a value like $(cmd) would have EXECUTED cmd as the agent. (#109)
	# (No literal single-quote appears below: this whole script is wrapped in
	# single quotes for runuser, so the quote chars are built with printf.)
	load_agent_env() {
		local _envf=$1 _line _key _val _last
		local _dq _sq
		_dq=$(printf "\042")   # one double-quote char
		_sq=$(printf "\047")   # one single-quote char
		while IFS= read -r _line || [[ -n $_line ]]; do
			_line=${_line#"${_line%%[![:space:]]*}"}   # strip leading whitespace
			[[ -z $_line || ${_line:0:1} == "#" ]] && continue
			_line=${_line#export }                     # tolerate an `export ` prefix
			[[ $_line == *=* ]] || continue            # no = -> not an assignment
			_key=${_line%%=*}                          # everything before the FIRST =
			_val=${_line#*=}                           # the rest, verbatim
			_key=${_key%"${_key##*[![:space:]]}"}      # trim whitespace around the key
			_key=${_key#"${_key%%[![:space:]]*}"}
			[[ $_key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
			# Strip ONE layer of matching surrounding quotes, if present, so the
			# interim single-quote workaround on existing files keeps working.
			if [[ ${#_val} -ge 2 ]]; then
				_last=${_val:${#_val}-1}
				if [[ ${_val:0:1} == "$_dq" && $_last == "$_dq" ]]; then
					_val=${_val:1:${#_val}-2}
				elif [[ ${_val:0:1} == "$_sq" && $_last == "$_sq" ]]; then
					_val=${_val:1:${#_val}-2}
				fi
			fi
			# export NAME=VALUE assigns the literal bytes of _val -- the value is
			# never re-parsed for expansion or command substitution.
			export "$_key=$_val"
		done <"$_envf"
	}
	# <<< load_agent_env <<<
	env_file="$HOME/.config/basecradle/agent.env"
	[[ -r $env_file ]] && load_agent_env "$env_file"
	cd "$1"
	shift
	exec "$@"
' wake-runner "$real_cwd" "$launch_bin" "$@"
