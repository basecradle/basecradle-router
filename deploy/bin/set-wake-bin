#!/usr/bin/env bash
#
# set-wake-bin — move ONE harness agent's `wake_bin` in the router's registry (#535).
#
# Installed ROOT-OWNED at /opt/basecradle-router/bin/set-wake-bin (root:root, 0755) by the
# deploy, beside wake-runner. Run by root, never through the `router` account's sudoers rule:
#
#   set-wake-bin <agent-key> <wake_bin>
#
# It exists so the NOC can seal or unseal one agent inside one short hold of that agent's
# wake-lock with no person in the loop: build the tree out of sight, then, holding the lock,
# give the tree its final name, run this, restart the daemon, release the lock. It changes
# exactly one field of exactly one entry, and nothing else in the file.
#
# THE VALUE IS JUDGED BY WAKE-RUNNER'S OWN GATE, BEFORE IT IS WRITTEN. `harness_wake_bin`
# below is wake-runner's, byte for byte (tests/test_set_wake_bin.py pins it), so a value this
# writes is one the next wake will accept, and a value the next wake would refuse is never
# written: a sealed path whose tree is missing or fails a check, a home path for an agent whose
# sealed tree exists, another agent's tree, a link, a `..`. A refusal names the check and
# leaves the registry as it was.
#
# THE DAEMON READS THE REGISTRY AT START. Until it restarts it still passes the old value, and
# wake-runner refuses that by name (argv[1] is not the registered wake_bin), so a forgotten
# restart is a loud refusal, never a wake from the old tree. This program restarts nothing:
# the restart is the NOC's step, in the same hold.
#
# THE WRITE. Under an exclusive lock on the registry's directory, so two runs cannot interleave.
# The new file is written to one fixed-name staging slot beside the registry, given the
# registry's own owner, group and mode, and renamed over it, so a reader sees the old file or
# the new one and never part of either. The slot is removed by every run, a failed one
# included (`trap`), and before every write, so nothing of this program outlives it.
set -euo pipefail

REGISTRY=/etc/basecradle-router/agents.json
STAGING=/etc/basecradle-router/.agents.json.set-wake-bin.tmp
MIN_UID=1000
# wake-runner's constant, and for its reason: whoever could choose it would choose what the
# agent's wake runs. tests/test_set_wake_bin.py holds the two equal.
SEALED_BASE=/opt/basecradle-harness

die() {
	printf 'set-wake-bin: %s\n' "$*" >&2
	exit 1
}

# The gate's refusals say `wake-runner:`, because they are its words. Read them as this
# program's: the value was refused here, before anything was written.

# >>> confined_path >>>
# Is PATH safe for the PRIVILEGED side to act on, when ROOT and everything under it
# belong to an account that is NOT root? The ONE gate every such path goes through.
#
# WHY IT IS NOT `realpath` + a prefix test (basecradle/basecradle#576). `realpath`
# FOLLOWS every symlink it walks and hands back the target; a prefix test then judges
# the target, and the privileged side acts on a path the unprivileged owner chose. The
# NOC's root deploy wrapper had 21 sites of exactly that shape, and a systemd fence is
# no defence: measured on systemd 255, `ReadWritePaths=-/home/%i/x` binds a symlink's
# TARGET read-write into the unit's namespace. Only refusing the link closes it. So this
# resolves NOTHING. It walks the path one component at a time from a trusted root and
# refuses the first component that is a link, which is a decision about the path the
# caller named rather than about wherever that path happened to point.
#
# `..` and `.` are refused HERE, by us, never delegated to a resolver — delegating is
# what makes a check a resolution again.
#
# A REFUSAL NAMES THE COMPONENT, NEVER THE TARGET. The target is the attacker's text;
# printing it into root's journal is a second, smaller version of trusting it, and it is
# never the thing an operator has to go fix. The component relative to the root is.
#
# Nothing here writes, creates, or removes: a refusal changes nothing, and so does a
# pass. The caller decides the consequence.
#
#   confined_path <label> <root> <path>
#     -> stdout: PATH verbatim (it is already canonical, or we refused it)
#     -> stderr + return 1: one line naming what is wrong and where
#
# The root must itself be a real, non-symlink directory. For a wake that is
# `/home/<agent>`: the agent owns everything *under* it, but replacing the directory
# entry itself needs write access to `/home`, which is root's — so it is the one
# component in the path that the account being confined cannot swap.
confined_path() {
	local label=$1 root=$2 path=$3
	local rest component walked

	# The root is checked as strictly as the path, and for the same reason: a gate that
	# assumes its caller validated its own arguments is a gate with a door beside it.
	# A dot segment here would move the whole confinement somewhere else.
	if [[ $root != /* || $root == */ || $root == *//* ]] ||
		[[ $root == */. || $root == */.. || $root == */./* || $root == */../* ]]; then
		printf 'wake-runner: refusing: %s: trusted root %s is not a canonical absolute path\n' \
			"$label" "$root" >&2
		return 1
	fi
	if [[ -L $root || ! -d $root ]]; then
		printf 'wake-runner: refusing: %s: trusted root %s is not a real directory\n' \
			"$label" "$root" >&2
		return 1
	fi
	if [[ $path != /* || $path == */ || $path == *//* ]]; then
		printf 'wake-runner: refusing: %s %s is not a canonical absolute path\n' \
			"$label" "$path" >&2
		return 1
	fi
	if [[ $path != "$root"/?* ]]; then
		printf 'wake-runner: refusing: %s %s is not under %s\n' "$label" "$path" "$root" >&2
		return 1
	fi

	rest=${path#"$root"/}
	walked=$root
	while [[ -n $rest ]]; do
		component=${rest%%/*}
		if [[ $component == "$rest" ]]; then
			rest=""
		else
			rest=${rest#*/}
		fi
		case "$component" in
		"." | "..")
			printf 'wake-runner: refusing: %s %s has a %s segment\n' "$label" "$path" "$component" >&2
			return 1
			;;
		esac
		walked="$walked/$component"
		# -L first: a dangling link is a link, and saying "does not exist" about one
		# would send an operator to create the very thing we are refusing to follow.
		if [[ -L $walked ]]; then
			printf 'wake-runner: refusing: %s: component %s under %s is a symlink; the privileged side does not follow it\n' \
				"$label" "${walked#"$root"/}" "$root" >&2
			return 1
		fi
		if [[ ! -e $walked ]]; then
			printf 'wake-runner: refusing: %s: %s does not exist under %s\n' \
				"$label" "${walked#"$root"/}" "$root" >&2
			return 1
		fi
		if [[ -n $rest && ! -d $walked ]]; then
			printf 'wake-runner: refusing: %s: %s under %s is not a directory\n' \
				"$label" "${walked#"$root"/}" "$root" >&2
			return 1
		fi
	done
	printf '%s' "$path"
}
# <<< confined_path <<<

# >>> harness_wake_bin >>>
# May root hand this harness WAKE_BIN to the drop? The ONE gate a harness agent's
# registry `wake_bin` goes through (#535). It has two places it may be, and only two:
#
#   - SEALED: under BASE/venv/USER/, the tree the NOC builds and an account other than the
#     agent owns. Before anything is exec'd, BASE and BASE/venv must be real directories
#     (no symlink), owned by root, with no group or other write, so nobody but root can
#     rename the agent's tree or put another in its place. The path is then walked by
#     `confined_path` rooted at BASE/venv/USER (no symlink, no `..`, nothing missing), so it
#     can name only THIS user's tree. And no entry on it, from that root down to the binary,
#     may be owned by the agent or writable by its group or by others: a tree the agent can
#     write is not sealed, whatever its path says, and running it would report a seal that
#     is absent. Last, neither the binary nor the interpreter its `#!` line names may be
#     setuid or setgid: the tree's owner runs package install code, and a set-id program
#     the agent's group can execute would let the agent become that owner by running it.
#     A directory's setgid bit on the path is how the tree hands the agent's group down,
#     and passes. The interpreter must be an absolute path that exists, named directly:
#     the kernel resolves a relative one against the agent's own clone, and `env` resolves
#     it off the agent's own PATH, so either would let the agent choose what runs.
#
#     The walk covers the binary's own path, never the interpreter's. A real venv's
#     `bin/python` is a link to the box's interpreter, and the one place this gate FOLLOWS a
#     link is there, to judge the file the kernel will finally run: it must exist, must not
#     be owned by the agent or writable by its group or by others, and must not be set-id.
#     That holds for the `#!` interpreter and for the tree's own `bin/python`, which is what
#     a uv console script runs either way. The directories above that file, and the rest of
#     the venv (`site-packages`), are the NOC's build to keep sealed; this gate does not
#     read them.
#   - HOME: under HOME (/home/USER), as before the seal, and ONLY while BASE/venv/USER does
#     not exist. Its existence, as anything at all, a dangling link included, means the NOC
#     has sealed this agent (only root can create an entry there), so a registry that still
#     names the home is refused rather than followed. Nothing trusted follows a path under
#     the agent's home once the agent is sealed, even when the registry flip was forgotten.
#
# Anywhere else is refused. Which of the two applies is the ROOT-OWNED registry's call,
# never inferred from the tree: inferring "sealed" from the tree's presence would read a
# sealed agent whose tree went missing as an unsealed one and fall back to its home, the
# one outcome this gate exists to make impossible. A sealed agent whose tree is missing or
# fails a check is a refused wake that names the check.
#
# Like `confined_path` it resolves nothing, writes nothing, and names the entry at fault,
# never a link's target. The ownership test is `-O` (owned by the effective uid), which is
# root's, because this script refuses to run as anyone else.
#
#   harness_wake_bin <label> <home> <base> <user> <wake_bin>
#     -> stdout: WAKE_BIN verbatim
#     -> stderr + return 1: one line naming what is wrong and where
not_set_id() {
	local label=$1 what=$2 entry=$3
	# `-u` and `-g` stat the file a link names, which is the point: the set-id bit that
	# takes effect at exec is the one on the file the kernel finally runs.
	if [[ -u $entry || -g $entry ]]; then
		printf 'wake-runner: refusing: %s: %s %s is setuid or setgid; it would run as its owner, not as the agent\n' \
			"$label" "$what" "$entry" >&2
		return 1
	fi
}

not_writable_by_others() {
	local label=$1 entry=$2 found
	found="$(find "$entry" -prune \( -perm -g+w -o -perm -o+w \) -print)" || {
		printf 'wake-runner: refusing: %s: could not read the mode of %s\n' "$label" "$entry" >&2
		return 1
	}
	if [[ -n $found ]]; then
		printf 'wake-runner: refusing: %s: %s is writable by its group or by others\n' \
			"$label" "$entry" >&2
		return 1
	fi
}

not_the_agents() {
	local label=$1 user=$2 entry=$3 found
	found="$(find "$entry" -prune -user "$user" -print)" || {
		printf 'wake-runner: refusing: %s: could not read the owner of %s\n' "$label" "$entry" >&2
		return 1
	}
	if [[ -n $found ]]; then
		printf 'wake-runner: refusing: %s: %s is owned by %s; a sealed tree is never the agent'"'"'s own\n' \
			"$label" "$entry" "$user" >&2
		return 1
	fi
	not_writable_by_others "$label" "$entry"
}

# An interpreter the wake will run: followed, deliberately and only here. A venv's
# `bin/python` is a link to the box's interpreter, and what runs is the file it finally
# names. So that file, wherever it is, must exist, may not be the agent's own or writable by
# its group or by others, and may not be set-id.
runs_as_installed() {
	local label=$1 user=$2 what=$3 interpreter=$4 found
	if [[ ! -e $interpreter ]]; then
		printf 'wake-runner: refusing: %s: the %s %s does not exist\n' "$label" "$what" "$interpreter" >&2
		return 1
	fi
	found="$(find -L "$interpreter" -prune \( -user "$user" -o -perm -g+w -o -perm -o+w \) -print)" || {
		printf 'wake-runner: refusing: %s: could not read the owner and mode of the %s %s\n' \
			"$label" "$what" "$interpreter" >&2
		return 1
	}
	if [[ -n $found ]]; then
		printf 'wake-runner: refusing: %s: the %s %s is owned by %s or writable by its group or by others\n' \
			"$label" "$what" "$interpreter" "$user" >&2
		return 1
	fi
	not_set_id "$label" "$what" "$interpreter"
}

harness_wake_bin() {
	local label=$1 home=$2 base=$3 user=$4 path=$5
	local venvs="$base/venv" tree="$base/venv/$user"
	local parent rest component walked line interpreter

	case "$path" in
	"$venvs"/*)
		for parent in "$base" "$venvs"; do
			if [[ -L $parent || ! -d $parent ]]; then
				printf 'wake-runner: refusing: %s: sealed parent %s is not a real directory\n' \
					"$label" "$parent" >&2
				return 1
			fi
			if [[ ! -O $parent ]]; then
				printf 'wake-runner: refusing: %s: sealed parent %s is not owned by root\n' \
					"$label" "$parent" >&2
				return 1
			fi
			not_writable_by_others "$label" "$parent" || return 1
		done
		confined_path "$label" "$tree" "$path" >/dev/null || return 1
		not_the_agents "$label" "$user" "$tree" || return 1
		rest=${path#"$tree"/}
		walked=$tree
		while [[ -n $rest ]]; do
			component=${rest%%/*}
			if [[ $component == "$rest" ]]; then
				rest=""
			else
				rest=${rest#*/}
			fi
			walked="$walked/$component"
			not_the_agents "$label" "$user" "$walked" || return 1
		done
		not_set_id "$label" "binary" "$path" || return 1
		# The kernel reads at most 256 bytes of a `#!` line; so do we.
		line=""
		IFS= read -r -n 256 line <"$path" || true
		if [[ $line == '#!'* ]]; then
			interpreter=${line#'#!'}
			interpreter=${interpreter#"${interpreter%%[![:space:]]*}"}
			interpreter=${interpreter%%[[:space:]]*}
			if [[ $interpreter != /* ]]; then
				printf 'wake-runner: refusing: %s: the #! interpreter %s of %s is not an absolute path\n' \
					"$label" "$interpreter" "$path" >&2
				return 1
			fi
			if [[ ${interpreter##*/} == env ]]; then
				printf 'wake-runner: refusing: %s: %s names its interpreter through %s, which resolves it off the agent'"'"'s own PATH\n' \
					"$label" "$path" "$interpreter" >&2
				return 1
			fi
			runs_as_installed "$label" "$user" "#! interpreter" "$interpreter" || return 1
		fi
		# And the tree's own interpreter, whatever the `#!` line says. uv names it there
		# directly for any path the kernel can read in a `#!` line, but writes a `#!/bin/sh`
		# trampoline that execs it instead for a longer one (127 bytes), which a `#!` check
		# alone would pass on /bin/sh's word. A venv's `bin/python` is what its scripts run.
		runs_as_installed "$label" "$user" "tree interpreter" "$tree/bin/python" || return 1
		;;
	"$home"/*)
		if [[ -e $tree || -L $tree ]]; then
			printf 'wake-runner: refusing: %s: %s is sealed (%s exists) but its wake_bin is still under %s; point the registry at the sealed tree\n' \
				"$label" "$user" "$tree" "$home" >&2
			return 1
		fi
		confined_path "$label" "$home" "$path" >/dev/null || return 1
		;;
	*)
		printf 'wake-runner: refusing: %s %s is under neither %s nor %s\n' \
			"$label" "$path" "$tree" "$home" >&2
		return 1
		;;
	esac
	printf '%s' "$path"
}
# <<< harness_wake_bin <<<

[[ ${EUID:-$(id -u)} -eq 0 ]] || die "must run as root"
[[ $# -eq 2 ]] || die "usage: set-wake-bin <agent-key> <wake_bin>"
key="$1"
wake_bin="$2"
[[ -n $key ]] || die "refusing: an empty agent key"

command -v jq >/dev/null 2>&1 || die "jq is required to read and write the registry"
[[ -r $REGISTRY ]] || die "registry not readable: $REGISTRY"

# Held from the first read to the rename, so the entry judged is the entry written.
exec 9<"${REGISTRY%/*}"
flock -x 9 || die "could not lock ${REGISTRY%/*}"

trap 'rm -f -- "$STAGING"' EXIT
rm -f -- "$STAGING"

entry="$(jq -r --arg k "$key" \
	'if has($k) then [(.[$k].kind // "github"), (.[$k].os_user // ""), (.[$k].wake_bin // "")] | @tsv else empty end' \
	"$REGISTRY")" || die "could not read registry $REGISTRY"
[[ -n $entry ]] || die "refusing: no agent $key in the registry"
IFS=$'\t' read -r kind user current <<<"$entry"
[[ $kind == harness ]] || die "refusing: agent $key is kind '$kind'; only a harness agent has a wake_bin"
[[ -n $user ]] || die "refusing: agent $key has no os_user"

# The same account check wake-runner makes, so the gate below is asked about a real agent.
id -u "$user" >/dev/null 2>&1 || die "refusing: no such user: $user"
target_uid="$(id -u "$user")"
[[ $target_uid -ge $MIN_UID ]] || die "refusing: $user (uid $target_uid) is not an agent login user"

checked="$(harness_wake_bin "wake_bin" "/home/$user" "$SEALED_BASE" "$user" "$wake_bin")" || exit 1
[[ -x $checked ]] || die "refusing: wake_bin is not executable: $checked"

if [[ $current == "$checked" ]]; then
	printf 'set-wake-bin: %s wake_bin is already %s; nothing written\n' "$key" "$checked"
	exit 0
fi

jq --arg k "$key" --arg v "$checked" '.[$k].wake_bin = $v' "$REGISTRY" >"$STAGING" ||
	die "could not write the new registry; $REGISTRY is unchanged"
chown --reference="$REGISTRY" -- "$STAGING"
chmod --reference="$REGISTRY" -- "$STAGING"
mv -f -- "$STAGING" "$REGISTRY"

printf 'set-wake-bin: %s wake_bin %s -> %s; restart basecradle-router.service for the daemon to read it\n' \
	"$key" "${current:-(none)}" "$checked"
