# BaseCradle fleet router — the webhook daemon, as a systemd service.
#
# Install to /etc/systemd/system/basecradle-router.service, then
#   systemctl daemon-reload && systemctl enable --now basecradle-router
#
# PREREQUISITES (this unit references them; it cannot start until they exist):
#   - the ASGI entrypoint `basecradle_router.app:create_app` and the `uvicorn`
#     runtime dependency — the composition root (a follow-up code issue);
#   - a deployable waker — HomeServerWaker (#29), which assembles the wake-runner
#     argv settled in #28. Until that is wired, the daemon has no real way to wake.
#   - /etc/basecradle-router/router.env filled out-of-band (the webhook secret
#     and the GITHUB_TRUSTED_ACTORS allow-list; see deploy/README.md).

[Unit]
Description=BaseCradle fleet router — webhook daemon that wakes the right agent
Documentation=https://github.com/basecradle/basecradle-router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=router
Group=router
WorkingDirectory=/opt/basecradle-router/app
EnvironmentFile=/etc/basecradle-router/router.env

# THE EVIDENCE STATE DIR (/var/lib/basecradle-router), created by systemd owned by
# this unit's User before the daemon starts — so the daemon never needs to mkdir in
# /var/lib and never runs as root to do it. It holds evidence.json: what the router
# has demonstrably done (deliveries verified, agents woken), which the NOC's
# claims-vs-evidence ledger reads (basecradle/basecradle#460). /var/lib, NOT /run:
# an age-of-proof that reset on every restart would report every proven capability
# as never-proven after each deploy. 0755 because the document holds no secrets and
# the NOC's converge must read it without a privilege grant.
StateDirectory=basecradle-router
StateDirectoryMode=0755

# NAME THE PROGRAM (#170). The daemon logs to stdout under `uv run uvicorn`, so
# without this journald stamps every line SYSLOG_IDENTIFIER=uv — the router's own
# log was attributed to its *launcher*. `journalctl -t basecradle-router` now reads
# the daemon (as `-t basecradle-wake-<slug>` reads one agent's wake), and the
# identifier is what deploy/vector.yaml prefixes each shipped line with, so a Better
# Stack Live Tail line says which program on the box emitted it.
SyslogIdentifier=basecradle-router

# SINGLE WORKER — load-bearing, never add --workers. The per-repo threading.Lock
# only serializes wakes within one process; multiple worker processes would each
# hold their own locks and could double-wake a repo's clone. Bind to localhost
# only — Caddy (the TLS front end, #31) reverse-proxies to this port.
ExecStart=/home/router/.local/bin/uv run --project /opt/basecradle-router/app \
    uvicorn --factory basecradle_router.app:create_app --host 127.0.0.1 --port 8000

Restart=on-failure
RestartSec=2s
# GRACEFUL DRAIN OF IN-FLIGHT WAKES on stop/restart (and on the pre-reboot drain in
# deploy/reboot-if-required.sh). Two directives make the drain real:
#   KillMode=mixed — SIGTERM at stop goes to the MAIN process ONLY, so uvicorn's
#     lifespan shutdown can drain `self._pending` while the wake subtree
#     (sudo -> wake-runner -> runuser -> claude) keeps running. NOTE: the main process
#     is `uv run`, not uvicorn itself, so this relies on `uv` forwarding SIGTERM to its
#     uvicorn child (recent uv does) — verify the drain actually fires on a live stop,
#     not just that the directive is set. The systemd default (control-group) SIGTERMs
#     every process in the cgroup at t=0 — severing the very wakes the drain exists to
#     protect. SIGKILL still sweeps the whole cgroup at the stop timeout as the backstop.
#   TimeoutStopSec=30min — wakes are deliberately UNBOUNDED (HomeServerWaker timeout=None)
#     and real agent turns run up to ~15 min, so the drain must tolerate a full-length
#     wake rather than SIGKILL it. Sized >=2x that worst case; a genuinely hung wake is
#     still cut at 30 min so a stop/reboot can never stall unbounded. Any consumer that
#     waits on `systemctl stop` (the reboot orchestrator's TimeoutStartSec) must stay
#     above this bound.
KillMode=mixed
TimeoutStopSec=30min

# --- Hardening -------------------------------------------------------------
# The wake (sudo -> runuser -> claude) runs as a CHILD of this service and so
# inherits this unit's sandbox namespace. That bounds what we can lock down:
#   - NoNewPrivileges MUST stay off — it would block the sudo -> wake-runner escalation.
#   - ProtectHome MUST stay off — the wake reads/writes the agent's clone under /home.
#   - ProtectSystem=strict and MemoryDenyWriteExecute are deliberately NOT used —
#     they would make /home read-only and break Node's JIT, killing the wake.
# The real isolation is the per-OS-user separation + the wake-runner boundary (#28),
# not namespace sandboxing of the router. (A future option for stronger per-wake
# isolation: launch each wake in its own `systemd-run --scope` outside this sandbox.)
# What we CAN safely set — none of it touches /home, JIT, or setuid execution:
ProtectSystem=full
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
