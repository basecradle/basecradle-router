# BaseCradle router — deployed-vs-main drift check (oneshot, run by the .timer).
#
# Makes drift loud instead of silent (issue #54): if the box stops matching
# origin/main, this unit FAILS, so it shows up in `systemctl --failed` and the
# journal instead of going unnoticed. It only reads — it never auto-deploys; the
# steward redeploys with deploy/deploy.sh after seeing the failure. (Auto-pulling
# from the internet onto the crown-jewels box, unattended, is a security trade we
# deliberately do NOT make — see deploy/README.md Part 3.)
#
# Install to /etc/systemd/system/, then:
#   systemctl daemon-reload && systemctl enable --now basecradle-router-drift.timer

[Unit]
Description=BaseCradle router — deployed-vs-main drift check
Documentation=https://github.com/basecradle/basecradle-router

[Service]
Type=oneshot
# Runs as the unprivileged daemon user; it only needs to read the (world-readable)
# deploy stamp and reach github.com over https. No secrets, no privilege.
User=router
Group=router
ExecStart=/opt/basecradle-router/app/deploy/drift-check.sh
