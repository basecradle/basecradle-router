# BaseCradle router — deployed-vs-main drift check (oneshot, run by the .timer).
#
# Makes drift loud instead of silent (issue #54): if the box stops running main's
# DAEMON code, this unit FAILS, so it shows up in `systemctl --failed` and the
# journal instead of going unnoticed. A gap confined to docs, skills, .github/, or
# CLAUDE.md passes green and says so in the journal (issue #189) — those change
# nothing the box runs, and an alarm that is routinely red for a harmless reason is
# the one that gets waved through when it finally matters. It only reads — this unit
# never deploys. What closes the gap is the NOC's auto-converge tick, which deploys
# main unattended within one tick of a merge (basecradle-noc#672) through the same
# `basecradle-noc deploy-router` flow a captain can hand-run: the box pulls a SHA the
# NOC's offline gate confirmed is branch-protected main, so there is still no
# credential on the box and no push-CD (deploy/README.md Part 3). A failure here that
# outlives the NOC's 45-min drift window means that unattended deploy failed or was
# held — read the NOC's router-deploy ledger.
#
# Install to /etc/systemd/system/, then:
#   systemctl daemon-reload && systemctl enable --now basecradle-router-drift.timer

[Unit]
Description=BaseCradle router — deployed-vs-main drift check
Documentation=https://github.com/basecradle/basecradle-router

[Service]
Type=oneshot
# Runs as the unprivileged daemon user (NOT root — least privilege): it only reads
# the deploy stamp and reaches github.com over https. The NOC's deploy-router op
# writes the stamp 0644, and /etc/basecradle-router is 750 root:router, so `router`
# traverses the dir as a group member and reads the stamp without sudo — no false
# "no stamp" alarm.
User=router
Group=router
ExecStart=/opt/basecradle-router/app/deploy/drift-check.sh
