# BaseCradle router — clean reboot when an OS update has staged one (oneshot).
#
# Runs deploy/bin/reboot-if-required.sh: a no-op unless /var/run/reboot-required exists,
# otherwise it drains the router and performs a controlled reboot. This is the
# "perform the reboot cleanly" half of issue #66; the post-boot health gate is
# basecradle-router-recovery.service.
#
# Driven by basecradle-router-reboot.timer (ENABLED — automatic reboots are ON per
# the founder decision in issue #66). This service is `static` (no [Install]); the
# timer activates it. It is also safe to `systemctl start` by hand to force an
# immediate clean reboot check (it no-ops unless a reboot is actually pending).
#
# Install (the timer is what gets enabled):
#   systemctl daemon-reload && systemctl enable --now basecradle-router-reboot.timer

[Unit]
Description=BaseCradle router — clean reboot when an OS update staged one
Documentation=https://github.com/basecradle/basecradle-router

[Service]
Type=oneshot
# The drain (systemctl stop basecradle-router) blocks until in-flight wakes finish,
# bounded by that unit's TimeoutStopSec (30min — wakes are unbounded, so the drain
# tolerates a full-length agent turn). Keep this start timeout above that bound so
# systemd never kills the orchestrator mid-drain (which would skip the reboot and
# mark the unit failed). Once it reaches `exec systemctl reboot`, the box goes down.
TimeoutStartSec=35min
# ROOT, DELIBERATELY — and therefore NOT out of the app tree (#297).
# Root is genuine here: the orchestrator runs `systemctl stop basecradle-router` and
# `systemctl reboot`, neither of which an unprivileged account can do. (Contrast
# basecradle-router-drift.service and basecradle-router-recovery.service, which only
# read and so run User=router.)
# Because it IS root, its ExecStart points at /opt/basecradle-router/bin/ — the
# root-owned install path THIS repo's deploy contract declares (deploy/bin/* is
# installed root:root 0755 on every deploy, the same path and the same reason as
# wake-runner and probe-ack) — never at /opt/basecradle-router/app/, whose ownership
# another repo's deploy op decides. The app tree is root-owned today
# (basecradle-noc#777), which is what makes the old path safe *now*; a root ExecStart
# whose safety rests on an ownership decision made outside this repo is the pattern,
# and the pattern is ours to close. No unit of ours runs root out of the app tree.
ExecStart=/opt/basecradle-router/bin/reboot-if-required.sh
