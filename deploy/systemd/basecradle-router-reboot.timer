# Schedule for the clean-reboot check (basecradle-router-reboot.service).
#
# AUTHORED, NOT YET ENABLED. Enabling THIS timer is what turns automatic reboots
# on — exactly the policy decision issue #66 defers until the mechanism is proven.
# Do NOT `enable --now` it until that decision is taken; the service it drives
# (reboot-if-required.sh) is safe to run by hand on a manual cadence in the
# meantime. When the policy lands, tune the window below and:
#   systemctl daemon-reload && systemctl enable --now basecradle-router-reboot.timer
#
# The window below is a low-traffic placeholder: 08:00 UTC ~= 03:00 US Central
# (Drawk's tz). The orchestrator no-ops unless a reboot is actually pending, so the
# timer firing daily is cheap; an actual reboot only happens on the days an update
# staged one. RandomizedDelaySec spreads the wake so it is never exactly on the hour.

[Unit]
Description=Run the BaseCradle router clean-reboot check in a low-traffic window

[Timer]
OnCalendar=*-*-* 08:00:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
