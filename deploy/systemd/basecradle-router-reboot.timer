# Schedule for the clean-reboot check (basecradle-router-reboot.service).
#
# ENABLED — automatic reboots are ON (founder decision, issue #66: "done" means
# auto-reboot is operational, not deferred). Enabling this timer is what turns
# automatic reboots on:
#   systemctl daemon-reload && systemctl enable --now basecradle-router-reboot.timer
#
# The window is 5:00 AM US Central, year-round. We name the timezone in the calendar
# spec (America/Chicago) rather than a fixed UTC time so it stays exactly 5 AM Central
# across DST with no manual babysitting — a fixed UTC value would drift an hour (5 AM
# Central is 10:00 UTC in CDT but 11:00 UTC in CST). The box runs systemd 255, which
# supports a tz in OnCalendar (verified: `systemd-analyze calendar` normalizes it and
# resolves the next elapse to 5 AM Central). The orchestrator (reboot-if-required.sh)
# NO-OPS unless a reboot is actually pending, so the timer firing daily is cheap; an
# actual reboot happens only on the days an OS update staged one. RandomizedDelaySec
# spreads the wake off the exact minute. The post-boot recovery gate
# (basecradle-router-recovery.service) confirms the box came back and alarms
# (systemctl --failed) if it did not — that gate is what makes an unattended reboot safe.

[Unit]
Description=Run the BaseCradle router clean-reboot check in a low-traffic window

[Timer]
OnCalendar=*-*-* 05:00:00 America/Chicago
RandomizedDelaySec=15min
# Persistent=false (the default) ON PURPOSE: a reboot must happen ONLY in the 5 AM
# window, never as a catch-up at an arbitrary time. Persistent=true would fire the
# service immediately when the timer starts after a missed run (box was off across
# 5 AM, or deploy.sh re-arms it with `enable --now` after inactivity) — and if a
# reboot were pending that would reboot the box off-window. Missing one day's window
# is harmless: the next day's 5 AM catches the still-pending reboot. (Contrast the
# DRIFT timer, which keeps Persistent=true — catching up a missed SHA comparison is
# both harmless and useful.)
Persistent=false

[Install]
WantedBy=timers.target
